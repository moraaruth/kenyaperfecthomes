# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB database instance (Atlas or self-hosted)
# e.g., mongodb+srv://username:password@cluster.mongodb.net/perfecthomes?retryWrites=true&w=majority
# If left empty, the application seamlessly runs on high-performance local/in-memory store.
MONGODB_URI=""

PORT=3000

# CLOUDINARY CONFIGURATION: Required for mobile and desktop property image upload,
# automatic format conversion (HEIC/HEIF/AVIF -> WebP/JPG), and responsive delivery.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ADMIN AUTHENTICATION SESSION SECRET: Used to sign HTTP-only administrator session cookies
ADMIN_SESSION_SECRET="perfect-homes-secure-admin-secret-2025"
